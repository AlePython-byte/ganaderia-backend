meta {
  name: Reset Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Request-Id: {{requestId}}
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "{{newPassword}}",
    "confirmPassword": "{{newPassword}}"
  }
}
